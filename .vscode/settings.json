{
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,
  "java.autobuild.enabled": false,
  "java.import.exclusions": [
    "**/android/**",
    "**/build/**",
    "**/.dart_tool/**"
  ],
  "java.project.importOnFirstTimeStartup": "disabled",

  "files.watcherExclude": {
    "**/android/.gradle/**": true,
    "**/android/build/**": true,
    "**/android/app/build/**": true,
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/.gradle/**": true
  },
  "search.exclude": {
    "**/android/.gradle": true,
    "**/android/build": true,
    "**/build": true,
    "**/.dart_tool": true
  },
  "files.exclude": {
    "**/android/.gradle": true,
    "**/.dart_tool": true
  }
}
